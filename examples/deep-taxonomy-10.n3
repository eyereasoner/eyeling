# Deep Taxonomy - depth 10
# One individual starts in class N0. Each rule adds the next taxonomy
# class and two side labels. Reaching the final level derives A2;
# the query returns only :ind a :A2.

@prefix : <http://eulersharp.sourceforge.net/2009/12dtb/test#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.

# fact
:ind a :N0.

# rules
{?X a :N0} => {?X a :N1, :I1, :J1}.
{?X a :N1} => {?X a :N2, :I2, :J2}.
{?X a :N2} => {?X a :N3, :I3, :J3}.
{?X a :N3} => {?X a :N4, :I4, :J4}.
{?X a :N4} => {?X a :N5, :I5, :J5}.
{?X a :N5} => {?X a :N6, :I6, :J6}.
{?X a :N6} => {?X a :N7, :I7, :J7}.
{?X a :N7} => {?X a :N8, :I8, :J8}.
{?X a :N8} => {?X a :N9, :I9, :J9}.
{?X a :N9} => {?X a :N10, :I10, :J10}.

{?X a :N10} => {?X a :A2}.

# query
{ :ind a :A2 } log:query { :ind a :A2 }.
