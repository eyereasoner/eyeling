@prefix : <http://example.org/#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:x :y 1 .
{
    :x :y 1 .
} => {
    :a :b :c .
} .
:a :b :c .

{ :x :y 1 . }
  pe:rule 1;
  pe:uses { 1 math:equalTo 1 . }.

{ 1 math:equalTo 1 . }
  pe:builtin math:equalTo.

{
  {
      :x :y 1 .
  } => {
      :a :b :c .
  } .
}
  pe:rule 1;
  pe:uses { 1 math:equalTo 1 . }.

{ :a :b :c . }
  pe:rule
    {
        {
            :x :y 1 .
        } => {
            :a :b :c .
        } .
    };
  pe:uses { :x :y 1 . }.
