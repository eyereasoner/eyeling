@prefix : <https://eyereasoner.github.io/ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:result :is true .

{ :result :is true . }
  pe:rule 1;
  pe:binding
    [ pe:var "A"; pe:value {
        ?A__0 => ?B__1 .
    } ],
    [ pe:var "B"; pe:value {
        :result :is true .
    } ];
  pe:uses
    {
        {
            ?A__0 => ?B__1 .
        } => {
            :result :is true .
        } .
    }.

{
  {
      ?A__0 => ?B__1 .
  } => {
      :result :is true .
  } .
}
  pe:builtin log:implies.
