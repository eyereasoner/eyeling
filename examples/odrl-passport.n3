#
# Is Alice allowed to sell her passport?
#
# - Default with her trust in information sources => no
# - Change her trust in the Gov and City to 5% => yes
# - Change her trustLevel in the request to 99% to see that 
#   the confidence level does not match her minimum required
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix math: <http://www.w3.org/2000/10/swap/math#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix dct:  <http://purl.org/dc/terms/>.
@prefix :     <http://example.org/odrl-passport#>.

# Trust model (0..1)
:Gov        :trust 0.95.
:City       :trust 0.80.
:RandomBlog :trust 0.30.
:DrunkUncle :trust 0.05.

#  Can Alice sell her passport with a trust level more than 90%?
:req1 a :Request;
  odrl:assignee :Alice;
  odrl:target   :Passport;
  odrl:action   odrl:sell;
  :trustLevel   0.90.

# ODRL Policies

# Governent 
:PolGov a odrl:Policy;
  dct:creator :Gov;
  odrl:prohibition [
  	odrl:target   :Passport;
  	odrl:action   odrl:sell
  ] .

# City
:PolCity a odrl:Policy;
  dct:creator :City;
  odrl:prohibition [
    odrl:target   :Passport;
    odrl:action   odrl:sell
  ] .

# RandomBlog 
:PolBlog a odrl:Policy;
  dct:creator :RandomBlog;
  odrl:permission [
    odrl:target   :Passport;
    odrl:action   odrl:sell
  ].

# DrunkUncle
:PolBlog a odrl:Policy;
  dct:creator :DrunkUncle;
  odrl:permission [
    odrl:target   :Passport;
    odrl:action   odrl:sell
  ].

# Minimal "ODRL + trust" evaluator

# Check which policies match the trust level
{
  ?Verb list:in (odrl:permit odrl:prohibit).

  ?Req a :Request ; :trustLevel ?Min .

  ?Iss :trust ?Trust.
  ?Trust math:notLessThan ?Min.

  (?Req ?Verb ?Score ?Iss) :cand true.
}
=>
{
  ?Req :decision (?Iss ?Verb ?Score).
}.

# Decision procedure: what is the best score
{
  ( ?Score {
	?Req :decision (?Iss ?Verb ?Score)
    } ?List ) log:collectAllIn _:x.
  ?List list:sort ?Sorted .
  ?Sorted list:last ?Choose .
  ?R :decision (?Winner ?V ?Choose).
}
=>
{
   :Alice :shouldChoose (?V ?Winner).
} .

# Helper functions -----------------------

# Candidate PERMIT for a request
{
  (?Req odrl:permit ?Score ?Iss) :cand true.
}
<=
{
  # Gather information about the request
  ?Req 
    a :Request; 
    odrl:assignee ?A; 
    odrl:target ?T; 
    odrl:action ?Act.
  
  # Gather information about the policy matching the request
  ?Pol 
    a odrl:Policy; 
    dct:creator ?Iss; 
    odrl:permission ?Perm.
  
  ?Perm odrl:target ?T; 
        odrl:action ?Act.

  # How much do we trust the issuer?
  ?Iss :trust ?Score.
}.

# Candidate PROHIBIT for a request
{
  (?Req odrl:prohibit ?Score ?Iss) :cand true.
}
<=
{
  # Gather information about the request
  ?Req 
    a :Request; 
    odrl:assignee ?A; 
    odrl:target ?T; 
    odrl:action ?Act .
  
  # Gather information about the policy matching the request
  ?Pol 
    a odrl:Policy; 
    dct:creator ?Iss; 
    odrl:prohibition ?Proh.
  
  ?Proh odrl:target ?T; 
    odrl:action ?Act.

  # How much do we trust the issuer?
  ?Iss :trust ?Score.
}.
